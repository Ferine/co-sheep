{
  "name": "co-sheep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm run build:helper && vite",
    "build": "tsc && vite build",
    "build:helper": "sh ./scripts/build-apple-helper.sh",
    "build:tauri": "pnpm run clean:bundle-temp && pnpm run build:helper && pnpm run build",
    "bundle:dmg": "bash ./scripts/build-dmg.sh",
    "clean:bundle-temp": "rm -f src-tauri/target/release/bundle/macos/rw.*.dmg src-tauri/target/release/bundle/dmg/rw.*.dmg",
    "preview": "vite preview",
    "tauri": "bash ./scripts/tauri-wrapper.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "4.1.9"
  }
}
